{
  "name": "umuryango",
  "version": "0.1.5",
  "private": true,
  "scripts": {
    "build": "node init && cargo build -p umuryango-app",
    "build:windows": "node init && bun run scripts/build-release.js windows",
    "build:android": "node init && bun run scripts/build-release.js android",
    "build:mobile": "node init && bun run scripts/build-release.js android",
    "build:all": "node init && bun run scripts/build-release.js all",
    "dev": "node init && bun run scripts/dev-native.js",
    "dev:backend": "node init && bun run scripts/dev-backend.js",
    "dev:frontend": "node init && bun run --cwd web dev",
    "dev:web": "node init && bun run --cwd web dev",
    "dev:all": "node init && bun run scripts/dev-all.js",
    "dev:both": "node init && bun run scripts/dev-all.js",
    "dev:fullstack": "node init && bun run scripts/dev-all.js",
    "dev:native": "node init && bun run scripts/dev-native.js",
    "dev:watch": "node init && cargo watch -x \"run -p umuryango-app\"",
    "dev:native:all": "node init && bun run scripts/dev-all.js --native",
    "dev:app:all": "node init && bun run scripts/dev-all.js --app",
    "dev:no-web": "node init && bun run scripts/dev-all.js --no-web",
    "release": "bun run scripts/release.js",
    "release:mobile": "bun run scripts/release.js --mobile",
    "release:all": "bun run scripts/release.js --build",
    "check": "cargo check -p umuryango-app",
    "fmt": "cargo fmt --all -- --check"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4"
}
