# Umuryango Workspace Environment Configuration

# Production PostgreSQL connection string (e.g. Neon with sslmode=require)
# PRODUCTION_DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Backend PostgreSQL connection string (local development or production on Render)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/umuryango

# Backend test database connection string
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/umuryango_test

# Backend HTTP API server bind address (defaults to 0.0.0.0:$PORT when PORT is set on Render)
BIND_ADDRESS=127.0.0.1:4433

# JWT signing secret (override with a strong secret in production)
JWT_SECRET=umuryango-dev-secret-key-at-least-32-chars-long!

# Backend API URL consumed by native app (Windows/Android) and web Next.js portal
# Defaults to https://umurango-rust.onrender.com/api/v1 (use http://localhost:4433/api/v1 for local backend)
API_URL=https://umurango-rust.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://umurango-rust.onrender.com/api/v1
